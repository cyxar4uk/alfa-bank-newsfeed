# Скопируйте в .env и при необходимости поменяйте. Без .env работают значения по умолчанию.

# PostgreSQL
POSTGRES_DB=newsfeed
POSTGRES_USER=newsfeed
POSTGRES_PASSWORD=newsfeed
# порт БД на хосте (только 127.0.0.1)
DB_PORT=5433

# порт API на хосте (только 127.0.0.1)
API_PORT=8000
# порт интерфейса на хосте (только 127.0.0.1): http://127.0.0.1:8080
WEB_PORT=8080

# каталог с данными кейса на хосте; CSV компаний — в DATA_DIR/companies/ или прямо в DATA_DIR
DATA_DIR=./data/raw
# true — перезагрузить данные, даже если те же файлы уже загружены
IMPORT_FORCE=false

# для запуска API и импорта без Docker (uv run ...): подключение к БД из compose
DATABASE_URL=postgresql://newsfeed:newsfeed@127.0.0.1:5433/newsfeed

# Модели организаторов (OpenAI-совместимый API). Ключ — только в .env, никогда в коде и браузере.
LLM_API_KEY=
# адрес зависит от того, откуда идёт запрос:
#   с машины разработчика — https://changellenge.up.railway.app/v1
#   с сервера VK Cloud    — https://api.alfahack-gateway26.ru/v1
LLM_BASE_URL=https://changellenge.up.railway.app/v1
# LLM_BASE_URL_RU — только памятка для стенда, кодом не читается: на сервере VK Cloud подставьте его в LLM_BASE_URL
# LLM_BASE_URL=https://api.alfahack-gateway26.ru/v1
# true — принимать любые id моделей провайдера (по умолчанию только 6 моделей кейса); id задаются в LLM_MODELS,
# LLM_FALLBACKS и LLM_PARSER_MODEL / LLM_OCR_MODEL (парсер)
LLM_ALLOW_ANY_MODEL=false
# свой суточный лимит сервиса на модели, ₽ (у организаторов 500 ₽ на ключ всей команды, сброс в 03:00 МСК);
# исчерпан — агент отвечает 503 «Budget has been exceeded», остальное API работает
LLM_DAILY_BUDGET_RUB=150
# разбор заранее (apps/api/src/api/precompute.py) тратит ключ при старте, поэтому по умолчанию выключен
# (на стенде включён в deploy/compose.server.yaml): агент сам собирает карточки «важно» (и «следить», пока
# потрачено меньше половины) демо-пользователей до того, как их откроют; статус — GET /api/precompute/status
PRECOMPUTE_ENABLED=false
# свой суточный бюджет разборов заранее, ₽ — часть LLM_DAILY_BUDGET_RUB; кончился — ждёт 03:00 МСК
PRECOMPUTE_BUDGET_RUB=100
# не больше сборок в час и одновременно в очереди агента (остальные места — пользователям)
PRECOMPUTE_PER_HOUR=20
PRECOMPUTE_IN_FLIGHT=1
# как часто смотреть новые события ленты, с
PRECOMPUTE_EVERY_S=300
# прогрев лент и карты рисков демо-пользователей при старте и раз в 12 минут
FEED_WARMUP=true
# модель по шагу агента, JSON (не заданные шаги — по умолчанию, см. apps/api/src/api/llm/client.py)
# LLM_MODELS={"draft": "deepseek/deepseek-v4.1-flash", "plan": "google/gemma-4-26b-a4b-it"}
# доп. параметры запроса по шагу, JSON — например, выключить рассуждения DeepSeek на доработке
# LLM_STEP_PARAMS={"revise": {"thinking": {"type": "disabled"}}}
