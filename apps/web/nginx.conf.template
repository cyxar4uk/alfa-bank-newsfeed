server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # index.html не кэшируем: после обновления он должен ссылаться на новые файлы сборки.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # API с того же адреса: у API нет CORS. Адрес — переменная API_UPSTREAM (по умолчанию сервис api в compose).
  # Адрес разрешается при запросе, а не при старте: без сервиса api интерфейс на тестовых данных всё равно работает.
  location /api/ {
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_read_timeout 60s;
  }

  location / {
    try_files $uri /index.html;
  }
}
