# Адрес API. Пусто — интерфейс работает на встроенных тестовых данных.
# В разработке: VITE_API_URL=/ — запросы /api идут через прокси dev-сервера на API_PROXY_TARGET.
VITE_API_URL=
# Какие методы уже брать из API (через запятую или all); остальное — тестовые данные.
VITE_API_LIVE=personas,company,health
# Куда dev-сервер проксирует /api.
API_PROXY_TARGET=http://127.0.0.1:8000
